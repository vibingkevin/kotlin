diff --git a/llvm/include/llvm/Support/LayoutQueryProfile.h b/llvm/include/llvm/Support/LayoutQueryProfile.h
new file mode 100644
index 000000000000..d131a7215b6f
--- /dev/null
+++ b/llvm/include/llvm/Support/LayoutQueryProfile.h
@@ -0,0 +1,157 @@
+//===- LayoutQueryProfile.h - 实验用布局查询统计 ----------------*- C++ -*-===//
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_SUPPORT_LAYOUTQUERYPROFILE_H
+#define LLVM_SUPPORT_LAYOUTQUERYPROFILE_H
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+#ifdef _WIN32
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace llvm { namespace layout_profile {
+constexpr unsigned SiteCount = 35;
+inline const char *const Labels[] = {"LLVMByteOrder",
+"LLVMPointerSize",
+"LLVMPointerSizeForAS",
+"LLVMIntPtrType",
+"LLVMIntPtrTypeForAS",
+"LLVMIntPtrTypeInContext",
+"LLVMIntPtrTypeForASInContext",
+"LLVMSizeOfTypeInBits",
+"LLVMStoreSizeOfType",
+"LLVMABISizeOfType",
+"LLVMABIAlignmentOfType",
+"LLVMCallFrameAlignmentOfType",
+"LLVMPreferredAlignmentOfType",
+"LLVMPreferredAlignmentOfGlobal",
+"LLVMElementAtOffset",
+"LLVMOffsetOfElement",
+"LLVMGetIntTypeWidth",
+"LLVMGetArrayLength",
+"LLVMGetArrayLength2",
+"LLVMGetVectorSize",
+"LLVMAlignOf",
+"LLVMSizeOf",
+"clang_getFieldDeclBitWidth",
+"clang_getArraySize",
+"clang_Type_getAlignOf",
+"clang_Type_getSizeOf",
+"clang_Type_getOffsetOf",
+"clang_Cursor_getOffsetOfField",
+"LLVM.StructLayoutMap",
+"Clang.MemoizedTypeInfo",
+"Clang.ASTRecordLayouts",
+"Clang.ObjCLayouts",
+"LLVMCountStructElementTypes",
+"LLVMIsPackedStruct",
+"clang_getNumElements"};
+struct Config {
+  const char *Directory = std::getenv("KN_LAYOUT_PROFILE_DIR");
+  const char *Mode = std::getenv("KN_LAYOUT_NATIVE_PROFILE");
+  bool Enabled = Directory && Mode &&
+      (!std::strcmp(Mode, "counts") || !std::strcmp(Mode, "time"));
+  bool Timed = Enabled && !std::strcmp(Mode, "time");
+};
+inline const Config &config() { static const Config C; return C; }
+struct Counters {
+  std::atomic<unsigned long long> Calls{0}, Inclusive{0}, Exclusive{0}, Hits{0}, Misses{0};
+};
+struct ThreadState {
+  // 0：LLVM/Clang 内部，1：LLVM C API，2：Clang C API。
+  Counters Rows[3][SiteCount];
+  unsigned Origin = 0;
+  unsigned long long Children = 0;
+};
+struct Registry {
+  std::mutex Mutex;
+  std::vector<ThreadState *> Threads;
+};
+inline void dump();
+inline Registry &registry() {
+  // 有意存活至进程退出，避免 TLS/静态析构顺序导致统计丢失。
+  static Registry *R = [] { auto *V = new Registry; std::atexit(dump); return V; }();
+  return *R;
+}
+inline ThreadState &threadState() {
+  static thread_local ThreadState *S = [] {
+    auto *V = new ThreadState;
+    auto &R = registry();
+    std::lock_guard<std::mutex> Lock(R.Mutex);
+    R.Threads.push_back(V);
+    return V;
+  }();
+  return *S;
+}
+inline unsigned long long now() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+class Scope {
+  ThreadState *S = nullptr;
+  Counters *Row = nullptr;
+  unsigned PreviousOrigin = 0;
+  unsigned long long Start = 0, BeforeChildren = 0;
+public:
+  explicit Scope(unsigned Id, unsigned Origin = 0) {
+    if (!config().Enabled) return;
+    S = &threadState();
+    PreviousOrigin = S->Origin;
+    if (Origin) S->Origin = Origin;
+    Row = &S->Rows[S->Origin][Id];
+    Row->Calls.fetch_add(1, std::memory_order_relaxed);
+    if (config().Timed) { BeforeChildren = S->Children; Start = now(); }
+  }
+  Scope(const Scope &) = delete;
+  Scope &operator=(const Scope &) = delete;
+  void cache(bool Hit) {
+    if (Row) (Hit ? Row->Hits : Row->Misses).fetch_add(1, std::memory_order_relaxed);
+  }
+  ~Scope() {
+    if (!S) return;
+    if (config().Timed) {
+      auto Elapsed = now() - Start;
+      auto Child = S->Children - BeforeChildren;
+      Row->Inclusive.fetch_add(Elapsed, std::memory_order_relaxed);
+      Row->Exclusive.fetch_add(Elapsed - Child, std::memory_order_relaxed);
+      S->Children = BeforeChildren + Elapsed;
+    }
+    S->Origin = PreviousOrigin;
+  }
+};
+inline void dump() {
+  auto &R = registry();
+  std::lock_guard<std::mutex> Lock(R.Mutex);
+  char Path[4096];
+#ifdef _WIN32
+  int Pid = _getpid();
+#else
+  int Pid = getpid();
+#endif
+  int N = std::snprintf(Path, sizeof(Path), "%s/native-%d-%p.tsv", config().Directory, Pid, static_cast<void *>(&R));
+  if (N < 0 || static_cast<size_t>(N) >= sizeof(Path)) { std::fputs("layout profile path too long\n", stderr); return; }
+  FILE *F = std::fopen(Path, "w");
+  if (!F) { std::perror("layout profile output"); return; }
+  std::fputs("origin\tid\tlabel\tcalls\tinclusive_ns\texclusive_ns\thits\tmisses\n", F);
+  const char *Origins[] = {"internal", "llvm-c-api", "clang-c-api"};
+  for (unsigned O = 0; O < 3; ++O) for (unsigned I = 0; I < SiteCount; ++I) {
+    unsigned long long Calls = 0, Inc = 0, Exc = 0, Hits = 0, Misses = 0;
+    for (auto *T : R.Threads) {
+      auto &C = T->Rows[O][I];
+      Calls += C.Calls.load(std::memory_order_relaxed); Inc += C.Inclusive.load(std::memory_order_relaxed);
+      Exc += C.Exclusive.load(std::memory_order_relaxed); Hits += C.Hits.load(std::memory_order_relaxed);
+      Misses += C.Misses.load(std::memory_order_relaxed);
+    }
+    std::fprintf(F, "%s\t%u\t%s\t%llu\t%llu\t%llu\t%llu\t%llu\n", Origins[O], I, Labels[I], Calls, Inc, Exc, Hits, Misses);
+  }
+  std::fprintf(F, "#mode\t%s\n#threads\t%zu\n", config().Mode, R.Threads.size());
+  std::fclose(F);
+}
+} }
+#endif
